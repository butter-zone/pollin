# ── Pollin Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your keys.
# .env is git-ignored — your secrets stay local.

# Remote conversion API (optional — falls back to LLM or mock)
VITE_CONVERSION_API_URL=http://localhost:3000

# LLM provider for UI generation — set at least ONE:
# Get yours at https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=
# Get yours at https://console.anthropic.com/settings/keys
VITE_ANTHROPIC_API_KEY=

# Figma import (optional)
# Get yours at https://www.figma.com/developers/api#access-tokens
VITE_FIGMA_TOKEN=
